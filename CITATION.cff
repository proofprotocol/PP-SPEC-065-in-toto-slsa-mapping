  - "Proof of Efficacy"
  - "in-toto"
  - "SLSA"
  - "attestation"
  - "DSSE"
  - "provenance"
  - "verification summary attestation"
  - "software supply chain"
  - "interoperability"
  - "evidence"
  - "efficacy"
  - "proof"
